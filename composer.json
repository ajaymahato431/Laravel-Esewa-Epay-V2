{
    "name": "ajaymahato/laravel-esewa-epay-v2",
    "description": "Production-ready eSewa ePay v2 integration for Laravel 10, 11, 12 and 13: HMAC signing, verified callbacks, status reconciliation and payable models.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "esewa",
        "epay",
        "payment",
        "payment-gateway",
        "nepal",
        "npr"
    ],
    "homepage": "https://github.com/ajaymahato/laravel-esewa-epay-v2",
    "support": {
        "issues": "https://github.com/ajaymahato/laravel-esewa-epay-v2/issues",
        "source": "https://github.com/ajaymahato/laravel-esewa-epay-v2"
    },
    "authors": [
        {
            "name": "Ajay Mahato",
            "email": "mahatoajay9988@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.11",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "AjayMahato\\Esewa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AjayMahato\\Esewa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AjayMahato\\Esewa\\EsewaServiceProvider"
            ],
            "aliases": {
                "Esewa": "AjayMahato\\Esewa\\Facades\\Esewa"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse",
        "check": [
            "@lint:test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
